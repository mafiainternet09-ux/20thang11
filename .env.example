# GEMINI_API_KEY: Required if Gemini AI API calls are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Dùng trên máy chủ Vercel / Express, KHÔNG công khai ra trình duyệt)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Khóa bí mật dùng để băm IP giới hạn tốc độ gửi lời chúc (tạo chuỗi ngẫu nhiên dài >= 32 ký tự)
RATE_LIMIT_SECRET="replace-with-a-random-32-char-secret-string"
